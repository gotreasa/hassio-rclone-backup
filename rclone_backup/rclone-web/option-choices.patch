diff --git a/e2e/option-choices.spec.ts b/e2e/option-choices.spec.ts
new file mode 100644
--- /dev/null
+++ b/e2e/option-choices.spec.ts
@@ -0,0 +1,45 @@
+import { expect, test } from '@playwright/test'
+import { getTestEnv, loginUrl } from './helpers'
+
+// An option with examples starts filled with its default. A <datalist> then only suggests entries
+// that match that text, so the other choices (iCloud Photos here) cannot be found.
+test('every choice of an option with examples can be picked, even with a default filled in', async ({
+    page,
+}) => {
+    await page.goto(loginUrl())
+    const { appUrl } = getTestEnv()
+    await page.waitForURL(appUrl + '/')
+    await page.goto(appUrl + '/remotes')
+    await page.getByRole('button', { name: 'Add New Remote' }).first().click()
+    await page.getByPlaceholder('Select type or search').fill('iCloud')
+    await page
+        .getByRole('option', { name: /^iCloud Drive/ })
+        .first()
+        .click()
+
+    const service = page.getByLabel('service', { exact: true })
+    await expect(service).toHaveValue('drive')
+
+    await page.getByRole('button', { name: 'Choices for service' }).click()
+    await expect(page.getByRole('menuitem', { name: /^drive/ })).toBeVisible()
+    await page.getByRole('menuitem', { name: /^photos/ }).click()
+
+    await expect(service).toHaveValue('photos')
+})
+
+test('a value that is not one of the examples can still be typed', async ({ page }) => {
+    await page.goto(loginUrl())
+    const { appUrl } = getTestEnv()
+    await page.waitForURL(appUrl + '/')
+    await page.goto(appUrl + '/remotes')
+    await page.getByRole('button', { name: 'Add New Remote' }).first().click()
+    await page.getByPlaceholder('Select type or search').fill('iCloud')
+    await page
+        .getByRole('option', { name: /^iCloud Drive/ })
+        .first()
+        .click()
+
+    const service = page.getByLabel('service', { exact: true })
+    await service.fill('custom-value')
+    await expect(service).toHaveValue('custom-value')
+})
