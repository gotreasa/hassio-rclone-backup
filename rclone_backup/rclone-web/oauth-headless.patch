diff --git a/src/rclone/config.ts b/src/rclone/config.ts
new file mode 100644
--- /dev/null
+++ b/src/rclone/config.ts
@@ -0,0 +1,119 @@
+import rclone from '@/rclone/client'
+
+// One question from rclone's config state machine (fs.ConfigOut in rclone). rclone asks these for
+// OAuth logins and for backend setup steps, such as choosing a OneDrive drive.
+export type ConfigQuestionOption = {
+    Name: string
+    Help?: string | null
+    Type?: string | null
+    IsPassword?: boolean
+    Exclusive?: boolean
+    DefaultStr?: string | null
+    Examples?: Array<{ Value?: string; Help?: string }> | null
+}
+
+export type ConfigQuestion = {
+    state: string
+    option: ConfigQuestionOption
+    // rclone's complaint about the previous answer, if any
+    error: string
+}
+
+// Resolves to the answer, or null when the user cancels
+export type ConfigAsk = (question: ConfigQuestion) => Promise<string | null>
+
+type ConfigOut = {
+    State?: string
+    Option?: ConfigQuestionOption | null
+    Error?: string
+}
+
+// rclone runs headless: never let it start its local browser login (a callback server on the rcd
+// host's 127.0.0.1:53682, which the user's browser cannot reach). It then asks for the result of
+// `rclone authorize` instead. config_* keys are not saved to the config file, so they are sent on
+// every call: rclone can reach the browser question later, after "refresh the token?" on an edit.
+const HEADLESS_PARAMETERS = { config_is_local: 'false' }
+
+// rclone saves a pasted token as typed, and a line break in it corrupts the config file: after a
+// restart rclone reads each extra line as a key of its own. A token from `rclone authorize` is
+// JSON (or a base64 blob) with no spaces in its values, so drop line breaks and spaces, and write
+// JSON back on one line.
+export function normaliseToken(value: string) {
+    const compact = value.replace(/\s+/g, '')
+    for (const candidate of [value, compact]) {
+        try {
+            return JSON.stringify(JSON.parse(candidate))
+        } catch {
+            // not JSON in this form
+        }
+    }
+    return compact
+}
+
+async function configCall(
+    path: '/config/create' | '/config/update',
+    query: Record<string, unknown>,
+    opt: Record<string, unknown> = {}
+) {
+    const out = await rclone(path, {
+        params: {
+            query: {
+                ...query,
+                opt: JSON.stringify({ nonInteractive: true, ...opt }),
+            },
+        },
+    })
+
+    return out as ConfigOut
+}
+
+// Creates (when type is set) or updates a remote, asking the user each question rclone returns.
+// Returns false if the user cancels; a cancelled new remote is deleted.
+export async function runRemoteConfig({
+    name,
+    type,
+    parameters,
+    ask,
+}: {
+    name: string
+    type?: string
+    parameters: Record<string, unknown>
+    ask: ConfigAsk
+}) {
+    const query = {
+        name,
+        ...(type ? { type } : {}),
+        parameters: JSON.stringify({ ...HEADLESS_PARAMETERS, ...parameters }),
+    }
+    let out = await configCall(type ? '/config/create' : '/config/update', query)
+
+    while (out.State && out.Option) {
+        const answer =
+            out.Option.Name === 'config_is_local'
+                ? HEADLESS_PARAMETERS.config_is_local
+                : await ask({ state: out.State, option: out.Option, error: out.Error ?? '' })
+
+        if (answer === null) {
+            if (type) {
+                await rclone('/config/delete', { params: { query: { name } } })
+            }
+            return false
+        }
+
+        out = await configCall(
+            '/config/update',
+            { name, parameters: JSON.stringify(HEADLESS_PARAMETERS) },
+            {
+                continue: true,
+                state: out.State,
+                result: out.Option.Name === 'config_token' ? normaliseToken(answer) : answer,
+            }
+        )
+    }
+
+    if (out.Error) {
+        throw new Error(out.Error)
+    }
+
+    return true
+}
