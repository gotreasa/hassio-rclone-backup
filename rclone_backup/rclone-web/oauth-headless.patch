diff --git a/e2e/remotes-oauth.spec.ts b/e2e/remotes-oauth.spec.ts
new file mode 100644
--- /dev/null
+++ b/e2e/remotes-oauth.spec.ts
@@ -0,0 +1,219 @@
+import { expect, test } from '@playwright/test'
+import { getTestEnv, loginUrl, rcloneRC } from './helpers'
+
+// A token in the shape `rclone authorize` prints. It is never used to reach Box.
+const TOKEN = JSON.stringify({
+    access_token: 'test-access',
+    token_type: 'Bearer',
+    refresh_token: 'test-refresh',
+    expiry: '2099-01-01T00:00:00Z',
+})
+
+test.afterEach(async () => {
+    await rcloneRC('/config/delete', { name: 'test-box' })
+})
+
+// Opens the Remotes page. Deeper pages are reached by clicking, as a user does: a reload on a
+// two-segment path cannot find the relative ./assets/ bundle.
+async function openRemotes(page: import('@playwright/test').Page) {
+    await page.goto(loginUrl())
+    const { appUrl } = getTestEnv()
+    await page.waitForURL(appUrl + '/')
+    await page.goto(appUrl + '/remotes')
+}
+
+async function startBoxRemote(page: import('@playwright/test').Page) {
+    await openRemotes(page)
+    await page.getByRole('button', { name: 'Add New Remote' }).first().click()
+    await page.getByPlaceholder('Remote name (for your reference)').fill('test-box')
+    await page.getByPlaceholder('Select type or search').fill('box')
+    await page.getByRole('option', { name: /^box/i }).first().click()
+    await page.getByRole('button', { name: 'Create Remote' }).click()
+    const dialog = page.getByRole('dialog')
+    await expect(dialog).toContainText('rclone authorize "box"')
+    return dialog
+}
+
+test('creates an OAuth remote with a token pasted from rclone authorize', async ({ page }) => {
+    const dialog = await startBoxRemote(page)
+    await dialog.getByLabel('config_token').fill(TOKEN)
+    await dialog.getByRole('button', { name: 'Continue' }).click()
+
+    await expect(page).toHaveURL(/\/remotes$/)
+    const config = (await rcloneRC('/config/get', { name: 'test-box' })) as Record<string, string>
+    expect(config.type).toBe('box')
+    expect(JSON.parse(config.token).refresh_token).toBe('test-refresh')
+    expect(config).not.toHaveProperty('config_is_local')
+})
+
+test('cancelling the token question removes the half-created remote', async ({ page }) => {
+    const dialog = await startBoxRemote(page)
+    await dialog.getByRole('button', { name: 'Cancel' }).click()
+
+    await expect(dialog).toBeHidden()
+    const { remotes } = (await rcloneRC('/config/listremotes')) as { remotes?: string[] }
+    expect(remotes ?? []).not.toContain('test-box')
+})
+
+test('editing an OAuth remote asks before refreshing its token', async ({ page }) => {
+    await rcloneRC('/config/create', {
+        name: 'test-box',
+        type: 'box',
+        parameters: { token: TOKEN, config_refresh_token: 'false' },
+        opt: { nonInteractive: true },
+    })
+    await openRemotes(page)
+    await page.getByRole('button', { name: 'Edit test-box' }).click()
+    await page.getByRole('button', { name: 'Save Changes' }).click()
+
+    const dialog = page.getByRole('dialog')
+    // The wording changes between rclone versions
+    await expect(dialog).toContainText(/token/i)
+    await dialog.getByRole('button', { name: /^false/ }).click()
+
+    await expect(page).toHaveURL(/\/remotes$/)
+    const config = (await rcloneRC('/config/get', { name: 'test-box' })) as Record<string, string>
+    expect(JSON.parse(config.token).refresh_token).toBe('test-refresh')
+})
+
+test('editing an OAuth remote can log in again without a browser question', async ({ page }) => {
+    await rcloneRC('/config/create', {
+        name: 'test-box',
+        type: 'box',
+        parameters: { token: TOKEN, config_refresh_token: 'false' },
+        opt: { nonInteractive: true },
+    })
+    await openRemotes(page)
+    await page.getByRole('button', { name: 'Edit test-box' }).click()
+    await page.getByRole('button', { name: 'Save Changes' }).click()
+
+    const dialog = page.getByRole('dialog')
+    await expect(dialog).toContainText(/token/i)
+    await dialog.getByRole('button', { name: /^true/ }).click()
+
+    await expect(dialog).toContainText('rclone authorize "box"')
+    await dialog.getByLabel('config_token').fill(TOKEN.replace('test-refresh', 'new-refresh'))
+    await dialog.getByRole('button', { name: 'Continue' }).click()
+
+    await expect(page).toHaveURL(/\/remotes$/)
+    const config = (await rcloneRC('/config/get', { name: 'test-box' })) as Record<string, string>
+    expect(JSON.parse(config.token).refresh_token).toBe('new-refresh')
+    expect(config).not.toHaveProperty('config_is_local')
+})
+
+// A token with a long access token, as some providers issue. It has no spaces, so it cannot wrap at
+// a word break.
+const LONG_TOKEN = JSON.stringify({
+    access_token: 'a'.repeat(600),
+    token_type: 'Bearer',
+    refresh_token: 'long-refresh',
+    expiry: '2099-01-01T00:00:00Z',
+})
+
+test('a token pasted with line breaks is saved on one line', async ({ page }) => {
+    const dialog = await startBoxRemote(page)
+    // Breaks after commas and inside a value, as a hand-wrapped or terminal-wrapped paste has
+    const wrapped = `  ${TOKEN.replaceAll(',', ',\n').replace('test-access', 'test-\naccess')}\n`
+    await dialog.getByLabel('config_token').fill(wrapped)
+    await dialog.getByRole('button', { name: 'Continue' }).click()
+
+    await expect(page).toHaveURL(/\/remotes$/)
+    const config = (await rcloneRC('/config/get', { name: 'test-box' })) as Record<string, string>
+    expect(config.token).not.toMatch(/[\n\r]/)
+    expect(JSON.parse(config.token)).toEqual(JSON.parse(TOKEN))
+    expect(Object.keys(config).sort()).toEqual(['token', 'type'])
+})
+
+test('a long token wraps inside the dialog and Continue stays on screen', async ({ page }) => {
+    const dialog = await startBoxRemote(page)
+    const field = dialog.getByLabel('config_token')
+    await field.fill(LONG_TOKEN)
+
+    const dialogBox = await dialog.boundingBox()
+    const fieldBox = await field.boundingBox()
+    expect(fieldBox!.x + fieldBox!.width).toBeLessThanOrEqual(dialogBox!.x + dialogBox!.width)
+    await expect(dialog.getByRole('button', { name: 'Continue' })).toBeInViewport({ ratio: 1 })
+
+    await dialog.getByRole('button', { name: 'Continue' }).click()
+    await expect(page).toHaveURL(/\/remotes$/)
+})
+
+test('pressing Enter in the token field submits the token', async ({ page }) => {
+    const dialog = await startBoxRemote(page)
+    const field = dialog.getByLabel('config_token')
+    await field.fill(TOKEN)
+    await field.press('Enter')
+
+    await expect(page).toHaveURL(/\/remotes$/)
+    const config = (await rcloneRC('/config/get', { name: 'test-box' })) as Record<string, string>
+    expect(JSON.parse(config.token).refresh_token).toBe('test-refresh')
+})
+
+async function createBox(parameters: Record<string, string>) {
+    await rcloneRC('/config/create', {
+        name: 'test-box',
+        type: 'box',
+        parameters: { config_refresh_token: 'false', ...parameters },
+        opt: { nonInteractive: true },
+    })
+}
+
+async function editBox(page: import('@playwright/test').Page) {
+    await page.getByRole('button', { name: 'Edit test-box' }).click()
+    await expect(page.getByRole('button', { name: 'Save Changes' })).toBeEnabled()
+}
+
+test('editing does not write back a config read on an earlier visit', async ({ page }) => {
+    // An earlier visit sees a key left over from a broken token
+    await createBox({ token: TOKEN, token_type: '"bearer",' })
+    await openRemotes(page)
+    await editBox(page)
+    // The cache is written at most once a second
+    await page.waitForTimeout(1500)
+
+    // The file is then repaired by hand, and the token renewed, outside the UI
+    await rcloneRC('/config/delete', { name: 'test-box' })
+    const NEW_TOKEN = TOKEN.replace('test-refresh', 'new-refresh')
+    await createBox({ token: NEW_TOKEN })
+
+    // A later visit, without logging in again
+    const { appUrl } = getTestEnv()
+    await page.goto(appUrl + '/remotes')
+    await editBox(page)
+    await page.getByRole('button', { name: 'Save Changes' }).click()
+    const dialog = page.getByRole('dialog')
+    await expect(dialog).toContainText(/token/i)
+    await dialog.getByRole('button', { name: /^false/ }).click()
+
+    await expect(page).toHaveURL(/\/remotes$/)
+    const config = (await rcloneRC('/config/get', { name: 'test-box' })) as Record<string, string>
+    expect(config).not.toHaveProperty('token_type')
+    expect(config.token).toBe(NEW_TOKEN)
+})
+
+test('editing saves a changed value and keeps the rest', async ({ page }) => {
+    await createBox({ token: TOKEN })
+    await openRemotes(page)
+    await editBox(page)
+    await page.getByLabel('client_id', { exact: true }).fill('my-client')
+    await page.getByRole('button', { name: 'Save Changes' }).click()
+    const dialog = page.getByRole('dialog')
+    await expect(dialog).toContainText(/token/i)
+    await dialog.getByRole('button', { name: /^false/ }).click()
+
+    await expect(page).toHaveURL(/\/remotes$/)
+    const config = (await rcloneRC('/config/get', { name: 'test-box' })) as Record<string, string>
+    expect(config.client_id).toBe('my-client')
+    expect(config.token).toBe(TOKEN)
+})
+
+test('a remote config is not kept in browser storage', async ({ page }) => {
+    await createBox({ token: TOKEN })
+    await openRemotes(page)
+    await editBox(page)
+    // The cache is written at most once a second
+    await page.waitForTimeout(1500)
+
+    const stored = await page.evaluate(() => JSON.stringify(window.localStorage))
+    expect(stored).not.toContain('test-access')
+})
diff --git a/src/components/ConfigQuestionDialog.tsx b/src/components/ConfigQuestionDialog.tsx
new file mode 100644
--- /dev/null
+++ b/src/components/ConfigQuestionDialog.tsx
@@ -0,0 +1,166 @@
+import { useCallback, useId, useRef, useState } from 'react'
+import { Alert, AlertDescription } from '@/components/ui/alert'
+import { Button } from '@/components/ui/button'
+import {
+    Dialog,
+    DialogContent,
+    DialogFooter,
+    DialogHeader,
+    DialogTitle,
+} from '@/components/ui/dialog'
+import { Field, FieldLabel } from '@/components/ui/field'
+import { Input } from '@/components/ui/input'
+import { Textarea } from '@/components/ui/textarea'
+import { useT } from '@/lib/i18n'
+import type { ConfigAsk, ConfigQuestion } from '@/rclone/config'
+
+type Pending = { question: ConfigQuestion; resolve: (answer: string | null) => void }
+
+// Shows rclone's config questions one at a time. Pass `ask` to runRemoteConfig and render `dialog`.
+export function useConfigQuestions() {
+    const [pending, setPending] = useState<Pending | null>(null)
+
+    const ask = useCallback<ConfigAsk>(
+        (question) => new Promise((resolve) => setPending({ question, resolve })),
+        []
+    )
+
+    const answer = useCallback(
+        (value: string | null) => {
+            pending?.resolve(value)
+            setPending(null)
+        },
+        [pending]
+    )
+
+    const dialog = pending ? (
+        <ConfigQuestionDialog
+            key={pending.question.state}
+            question={pending.question}
+            onAnswer={answer}
+        />
+    ) : null
+
+    return { ask, dialog }
+}
+
+function ConfigQuestionDialog({
+    question,
+    onAnswer,
+}: {
+    question: ConfigQuestion
+    onAnswer: (value: string | null) => void
+}) {
+    const t = useT()
+    const fieldId = useId()
+    const { option, error } = question
+    const [value, setValue] = useState(option.DefaultStr ?? '')
+    const answered = useRef(false)
+    const choices = option.Exclusive ? (option.Examples ?? []) : []
+    // Tokens from `rclone authorize` are long JSON, so give them room
+    const multiline = !option.IsPassword && option.Name === 'config_token'
+
+    const submit = (next: string) => {
+        answered.current = true
+        onAnswer(next)
+    }
+
+    return (
+        <Dialog
+            open
+            onOpenChange={(open) => {
+                if (!open && !answered.current) onAnswer(null)
+            }}
+        >
+            {/* Fit the screen and scroll, so the buttons stay reachable */}
+            <DialogContent className="max-h-[calc(100dvh-2rem)] grid-cols-1 overflow-y-auto sm:max-w-lg">
+                <DialogHeader>
+                    <DialogTitle>{t('remotesConfig.title')}</DialogTitle>
+                </DialogHeader>
+
+                <pre className="max-h-64 overflow-auto whitespace-pre-wrap font-sans text-sm text-muted-foreground">
+                    {option.Help}
+                </pre>
+
+                {error ? (
+                    <Alert variant="destructive">
+                        <AlertDescription>{error}</AlertDescription>
+                    </Alert>
+                ) : null}
+
+                {choices.length > 0 ? (
+                    <div className="flex flex-col gap-2">
+                        {choices.map((choice) => (
+                            <Button
+                                key={choice.Value}
+                                type="button"
+                                variant={choice.Value === option.DefaultStr ? 'default' : 'outline'}
+                                className="h-auto justify-start whitespace-normal text-left"
+                                onClick={() => submit(choice.Value ?? '')}
+                            >
+                                {choice.Help ? `${choice.Value}: ${choice.Help}` : choice.Value}
+                            </Button>
+                        ))}
+                    </div>
+                ) : (
+                    <form
+                        id={`${fieldId}-form`}
+                        onSubmit={(event) => {
+                            event.preventDefault()
+                            submit(value)
+                        }}
+                    >
+                        <Field>
+                            <FieldLabel htmlFor={fieldId}>{option.Name}</FieldLabel>
+                            {multiline ? (
+                                <Textarea
+                                    id={fieldId}
+                                    name={option.Name}
+                                    value={value}
+                                    onChange={(event) => setValue(event.target.value)}
+                                    // A token is one line, so Enter submits it like an input
+                                    onKeyDown={(event) => {
+                                        if (
+                                            event.key === 'Enter' &&
+                                            !event.nativeEvent.isComposing
+                                        ) {
+                                            event.preventDefault()
+                                            event.currentTarget.form?.requestSubmit()
+                                        }
+                                    }}
+                                    rows={5}
+                                    // A token has no spaces: wrap it anywhere, at the dialog's width
+                                    className="field-sizing-fixed max-h-48 break-all font-mono text-xs"
+                                    spellCheck={false}
+                                    autoFocus
+                                />
+                            ) : (
+                                <Input
+                                    id={fieldId}
+                                    name={option.Name}
+                                    type={option.IsPassword ? 'password' : 'text'}
+                                    value={value}
+                                    onChange={(event) => setValue(event.target.value)}
+                                    autoComplete="off"
+                                    spellCheck={false}
+                                    autoFocus
+                                />
+                            )}
+                        </Field>
+                    </form>
+                )}
+
+                <DialogFooter>
+                    <Button type="button" variant="outline" onClick={() => onAnswer(null)}>
+                        {t('common.cancel')}
+                    </Button>
+                    {choices.length > 0 ? null : (
+                        <Button type="submit" form={`${fieldId}-form`}>
+                            {t('remotesConfig.continue')}
+                        </Button>
+                    )}
+                </DialogFooter>
+            </DialogContent>
+        </Dialog>
+    )
+}
