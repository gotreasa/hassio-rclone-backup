new file mode 100644
--- /dev/null
+++ b/e2e/no-serves.spec.ts
@@ -0,0 +1,80 @@
+import { mkdtempSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { expect, type Page, test } from '@playwright/test'
+import { getTestEnv, loginUrl } from './helpers'
+
+// Serves cannot be reached from outside the add-on's container, so the app has no Serves UI and
+// never calls serve/*. Self-update would replace the rclone binary inside the image, so it is gone too.
+
+async function recordRcCalls(page: Page) {
+    const servePaths: string[] = []
+    const commandBodies: string[] = []
+    page.on('request', (request) => {
+        const { pathname } = new URL(request.url())
+        if (pathname.includes('/serve/')) servePaths.push(pathname)
+    })
+    // A pass-through route makes Chromium buffer the body, which a plain request listener misses
+    await page.route('**/core/command', async (route) => {
+        commandBodies.push(route.request().postData() ?? '')
+        await route.continue()
+    })
+    return { servePaths, commandBodies }
+}
+
+test('the app has no Serves tab, card or route and never calls serve/*', async ({ page }) => {
+    const calls = await recordRcCalls(page)
+    const { appUrl } = getTestEnv()
+    await page.goto(loginUrl())
+    await page.waitForURL(appUrl + '/')
+
+    const nav = page.locator('header nav')
+    await expect(nav.getByRole('link', { name: 'Mounts' })).toBeVisible()
+    await expect(nav.getByRole('link', { name: 'Serves' })).toHaveCount(0)
+    await expect(page.getByText('Mounts', { exact: true }).last()).toBeVisible()
+    await expect(page.getByText('Serves', { exact: true })).toHaveCount(0)
+
+    // Navigate inside the app: the build uses relative asset paths, so a cold load of a nested
+    // path such as /serves/new cannot find its bundle (HA always opens the panel at its root)
+    for (const path of ['/serves', '/serves/new']) {
+        await page.getByRole('link', { name: 'Mounts' }).click()
+        await expect(page).toHaveURL(appUrl + '/mounts')
+        await page.evaluate((target) => {
+            window.history.pushState({}, '', target)
+            window.dispatchEvent(new PopStateEvent('popstate'))
+        }, path)
+        await expect(page).toHaveURL(appUrl + '/')
+        await expect(page.getByRole('heading', { name: 'Dashboard' })).toBeVisible()
+    }
+
+    await page.waitForTimeout(1000)
+    expect(calls.servePaths).toEqual([])
+})
+
+test('the file browser has no Download button', async ({ page }) => {
+    const calls = await recordRcCalls(page)
+    const folder = mkdtempSync(join(tmpdir(), 'no-serves-'))
+    writeFileSync(join(folder, 'report.txt'), 'hello')
+
+    const { appUrl } = getTestEnv()
+    await page.goto(loginUrl())
+    await page.waitForURL(appUrl + '/')
+    await page.goto(`${appUrl}/local?${new URLSearchParams({ disk: folder })}`)
+
+    await expect(page.getByRole('button', { name: 'Rename report.txt' })).toBeAttached()
+    await expect(page.getByRole('button', { name: 'Download report.txt' })).toHaveCount(0)
+    expect(calls.servePaths).toEqual([])
+})
+
+test('the app never checks for or runs an rclone self-update', async ({ page }) => {
+    const calls = await recordRcCalls(page)
+    const { appUrl } = getTestEnv()
+    await page.goto(loginUrl())
+    await page.waitForURL(appUrl + '/')
+    await page.goto(appUrl + '/settings')
+    await expect(page.getByRole('heading', { name: 'Settings' })).toBeVisible()
+
+    await page.waitForTimeout(1000)
+    await expect(page.getByRole('button', { name: 'Update available' })).toHaveCount(0)
+    expect(calls.commandBodies.filter((body) => body.includes('selfupdate'))).toEqual([])
+})
